# Sepolia deployment environment — SERVER / DEPLOY-ONLY variables.
# Consumed by forge scripts (contracts/) and the Next.js server route handler (frontend/).
# These must NEVER be prefixed with NEXT_PUBLIC_ — doing so would leak them into the
# browser bundle. They are never read at client-imported module top level.
#
# Copy this file to contracts/.env and fill in the values (contracts/.env is gitignored).

# Sepolia RPC endpoint (Alchemy/Infura free tier). Used by:
#   - contracts/script/DeployDemoSepolia.s.sol (forge --rpc-url)
#   - frontend server-side provider (src/lib/rpc.ts createServerProvider, chainId 11155111)
SEPOLIA_RPC_URL=https://sepolia.g.alchemy.com/v2/<YOUR_API_KEY>

# Etherscan API key (free tier, works for Sepolia — see research.md R0.3).
# Read automatically by forge for `--verify` on Sepolia broadcasts.
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>

# Sepolia master/deployer private key (deployer + replenishment source).
# This is the funding account (funded via public faucets — research.md R0.1).
# NEVER documented in any repo file, README, or guide — developer-held only.
SEPOLIA_DEPLOYER_KEY=<YOUR_PRIVATE_KEY>
